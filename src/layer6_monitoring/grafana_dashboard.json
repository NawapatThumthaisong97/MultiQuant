              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Cumulative Realized PnL",
      "type": "stat",
      "targets": [
        {
          "expr": "multiquant_realized_pnl_usd",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
