        {
          "expr": "multiquant_portfolio_cash_usd",
          "legendFormat": "Cash (USD)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
