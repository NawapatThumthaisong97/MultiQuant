# =================================================================
# MultiQuant Configuration Environment Variables
# Copy this file to .env and adjust values for your environment.
# =================================================================

# --- General System ---
ENV=development
LOG_LEVEL=INFO

# --- Layer 1: Market Connectivity (WebSockets) ---
WS_BINANCE_URL=wss://stream.binance.com:9443/ws
DEFAULT_SYMBOLS=["BTCUSDT", "ETHUSDT", "SOLUSDT"]
WS_RECONNECT_MAX_RETRIES=15
WS_PING_INTERVAL_SEC=20

# --- Layer 3: Risk & Position Sizing ---
MAX_PORTFOLIO_RISK_PCT=0.015
MAX_DRAWDOWN_LIMIT_PCT=0.15
ATR_PERIOD=14
ATR_MULTIPLIER=2.0

# --- Layer 4: Simulated OMS ---
BASE_SLIPPAGE_BPS=3.0
TAKER_FEE_PCT=0.0005
MAKER_FEE_PCT=0.0002

# --- Layer 5: State & Database Management ---
SQLITE_DB_PATH=multiquant_state.db
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Layer 6: Monitoring & Alerting ---
DISCORD_WEBHOOK_URL=
PROMETHEUS_METRICS_PORT=8000
